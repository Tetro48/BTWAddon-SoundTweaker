      "net.tetro48.sound_tweaker.SoundTweakerMod"
    ],
    "btw:addon": [
      "net.tetro48.sound_tweaker.SoundTweakerAddon"
    ]
  },
  "custom": {
    "btw:addon_prefix": "ST"
  },
  "mixins": [
    "sound_tweaker.mixins.json"
