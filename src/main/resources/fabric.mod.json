{
  "schemaVersion": 1,
  "id": "sound_tweaker",
  "version": "${version}",
  "name": "Sound Tweaker",
  "description": "This makes sounds of mechanical machines individually customizable.",
  "authors": [
    "Tetro48"
  ],
  "contact": {
    "homepage": "https://legacyfabric.net/",
    "sources": "https://github.com/Legacy-Fabric/fabric-example-mod"
  },
  "license": "CC0-1.0",
  "icon": "assets/sound_tweaker/icon.png",
  "environment": "*",
  "entrypoints": {
